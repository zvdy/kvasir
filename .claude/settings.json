{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(cargo *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git pull --ff-only*)",
      "Bash(git fetch*)",
      "Bash(git push -u origin agent/*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create*)",
      "Bash(nvidia-smi*)",
      "Bash(scripts/doctor.sh)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(git worktree*)",
      "Bash(git merge origin/main*)",
      "Bash(scripts/check-agent-pr.sh*)",
      "Bash(flock /tmp/kvasir-gpu.lock make *)",
      "Bash(flock /tmp/kvasir-gpu.lock cargo *)"
    ],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr merge*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/no-push-main.sh"
          }
        ]
      }
    ]
  }
}
